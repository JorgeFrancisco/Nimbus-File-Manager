<?xml version="1.0" encoding="UTF-8"?>
<!--
	Tests log to the console only. The application's logback-spring.xml also writes
	to <workspace>/logs/nimbus-file-manager.log, so the suite was appending to the
	very file the running installation writes to. Tests that provoke a warning on
	purpose - SecureFileMoveTest asserts the "file system disagrees" warning - left
	entries there indistinguishable from a real incident, and an investigation
	counted fifteen of them before noticing they all came from @TempDir paths.
	Logback picks logback-test.xml over logback-spring.xml, so nothing else changes.
-->
<configuration>

	<include resource="org/springframework/boot/logging/logback/defaults.xml"/>
	<include resource="org/springframework/boot/logging/logback/console-appender.xml"/>

	<root level="INFO">
		<appender-ref ref="CONSOLE"/>
	</root>

</configuration>