<?xml version="1.0" encoding="UTF-8"?>
<!--
	File logging with weekly rotation. Spring Boot picks up this logback-spring.xml
	automatically; the workspace root is injected from the application property so
	the logs land in the same <workspace>/logs folder the WorkspaceBootstrapListener
	creates on start (logback also creates the parent folder itself, so it never
	depends on that listener having run first). The console appender and the log
	patterns reuse Spring Boot's defaults, so console output stays unchanged, and
	any logging.level.* property keeps working on top of this configuration.
-->
<configuration>

	<include resource="org/springframework/boot/logging/logback/defaults.xml"/>
	<include resource="org/springframework/boot/logging/logback/console-appender.xml"/>

	<springProperty name="WORKSPACE" source="nimbus-file-manager.workspace" defaultValue="./workspace"/>

	<property name="LOG_DIR" value="${WORKSPACE}/logs"/>

	<appender name="FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
		<file>${LOG_DIR}/nimbus-file-manager.log</file>
		<rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
			<!--
				%d{yyyy-ww} rolls the file over once per week (week-of-year); %i splits it
				again within the week whenever the active file reaches maxFileSize.
			-->
			<fileNamePattern>${LOG_DIR}/nimbus-file-manager-%d{yyyy-ww}.%i.log</fileNamePattern>
			<maxFileSize>20MB</maxFileSize>
			<maxHistory>52</maxHistory>
			<totalSizeCap>1GB</totalSizeCap>
			<cleanHistoryOnStart>true</cleanHistoryOnStart>
		</rollingPolicy>
		<encoder>
			<pattern>${FILE_LOG_PATTERN}</pattern>
			<charset>${FILE_LOG_CHARSET}</charset>
		</encoder>
	</appender>

	<root level="INFO">
		<appender-ref ref="CONSOLE"/>
		<appender-ref ref="FILE"/>
	</root>

</configuration>