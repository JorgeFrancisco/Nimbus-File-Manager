<?xml version="1.0" encoding="UTF-8"?>
<!--
	File logging rotated by day and by size. Spring Boot picks up this logback-spring.xml
	automatically; the workspace root is injected from the application property so
	the logs land in the same <workspace>/logs folder the WorkspaceBootstrapListener
	creates on start (logback also creates the parent folder itself, so it never
	depends on that listener having run first). The console appender and the log
	patterns reuse Spring Boot's defaults, so console output stays unchanged, and
	any logging.level.* property keeps working on top of this configuration.
-->
<configuration>

	<include resource="org/springframework/boot/logging/logback/defaults.xml"/>
	<include resource="org/springframework/boot/logging/logback/console-appender.xml"/>

	<!-- The property is published before Logback reads it, by the same class the rest of
	     the application asks. The default only covers a run that somehow bypassed that,
	     and it names the same place rather than a second opinion beside the project. -->
	<springProperty name="WORKSPACE" source="nimbus-file-manager.workspace"
			defaultValue="${user.home}/Nimbus File Manager/workspace"/>

	<property name="LOG_DIR" value="${WORKSPACE}/logs"/>

	<appender name="FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
		<file>${LOG_DIR}/nimbus-file-manager.log</file>
		<rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
			<!--
				%d{yyyyMMdd} rolls the file over once per day; %i splits it again within
				the same day whenever the active file reaches maxFileSize, so an archive is
				always dated and numbered in the order it was written. maxHistory counts in
				the unit of the date pattern - days here - and drops the oldest archive
				past that window. The window is sized for how long it takes to notice a
				problem, not for how much a log weighs: a file that ended up in the wrong
				place is found weeks later, and the log of the run that moved it has to
				still be there. totalSizeCap is the emergency brake behind it.
			-->
			<fileNamePattern>${LOG_DIR}/nimbus-file-manager-%d{yyyyMMdd}.%i.log</fileNamePattern>
			<maxFileSize>20MB</maxFileSize>
			<maxHistory>30</maxHistory>
			<totalSizeCap>2GB</totalSizeCap>
			<cleanHistoryOnStart>true</cleanHistoryOnStart>
		</rollingPolicy>
		<encoder>
			<pattern>${FILE_LOG_PATTERN}</pattern>
			<charset>${FILE_LOG_CHARSET}</charset>
		</encoder>
	</appender>

	<root level="INFO">
		<appender-ref ref="CONSOLE"/>
		<appender-ref ref="FILE"/>
	</root>

</configuration>