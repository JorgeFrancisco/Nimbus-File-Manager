# Registers the workspace decision before Logback opens the log file, and starts
# the embedded database before the DataSource is built. Loaded from
# spring.factories, which is what Spring Boot reads for EnvironmentPostProcessor -
# the META-INF/spring/*.imports form applies to auto-configuration, not to this.
org.springframework.boot.env.EnvironmentPostProcessor=\
  br.com.jorgemelo.nimbusfilemanager.shared.infrastructure.config.WorkspaceEnvironmentPostProcessor,\
  br.com.jorgemelo.nimbusfilemanager.database.infrastructure.config.EmbeddedDatabaseBootstrap

# Stops the cluster once the context - and with it the connection pool - is closed.
org.springframework.context.ApplicationListener=\
  br.com.jorgemelo.nimbusfilemanager.database.infrastructure.config.EmbeddedDatabaseShutdown