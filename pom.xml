			<artifactId>spring-boot-starter-oauth2-client</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-mail</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-data-jpa</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-validation</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-batch</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-actuator</artifactId>
		</dependency>
		<dependency>
			<groupId>org.webjars.npm</groupId>
			<artifactId>bootstrap-icons</artifactId>
			<version>${bootstrap-icons.version}</version>
		</dependency>
		<dependency>
			<groupId>org.webjars.npm</groupId>
			<artifactId>leaflet</artifactId>
			<version>${leaflet.version}</version>
		</dependency>
		<!-- Runtime only: no production class imports org.postgresql. It was compile
		     scope while the backup copied tables through the driver's COPY API; the
		     backup now runs pg_dump, and the driver went back to being what it always
		     was here - the JDBC implementation Spring loads by name. -->
		<dependency>
			<groupId>org.postgresql</groupId>
			<artifactId>postgresql</artifactId>
			<scope>runtime</scope>
		</dependency>
		<dependency>
			<groupId>org.springdoc</groupId>
			<artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
			<version>${springdoc.version}</version>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-test</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.springframework.security</groupId>
			<artifactId>spring-security-test</artifactId>
			<scope>test</scope>
		</dependency>
		<!-- Testcontainers: the @SpringBootTest integration tests spin up a throwaway
		     PostgreSQL container (via @ServiceConnection) instead of a shared external DB,
		     so each test class is isolated and they can run in parallel. Versions come from
		     the Spring Boot BOM. Requires Docker on the machine/CI runner. -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-testcontainers</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.testcontainers</groupId>
			<artifactId>junit-jupiter</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.testcontainers</groupId>
			<artifactId>postgresql</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.flywaydb</groupId>
			<artifactId>flyway-core</artifactId>
		</dependency>
		<dependency>
			<groupId>org.flywaydb</groupId>
			<artifactId>flyway-database-postgresql</artifactId>
		</dependency>
		<dependency>
			<groupId>org.projectlombok</groupId>
			<artifactId>lombok</artifactId>
			<optional>true</optional>
		</dependency>
		<dependency>
			<groupId>com.drewnoakes</groupId>
			<artifactId>metadata-extractor</artifactId>
			<version>${metadata-extractor.version}</version>
		</dependency>
		<dependency>
			<groupId>com.twelvemonkeys.imageio</groupId>
			<artifactId>imageio-core</artifactId>
			<version>${twelvemonkeys.version}</version>
		</dependency>
		<dependency>
			<groupId>com.twelvemonkeys.imageio</groupId>
			<artifactId>imageio-webp</artifactId>
			<version>${twelvemonkeys.version}</version>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-configuration-processor</artifactId>
			<optional>true</optional>
		</dependency>
		<dependency>
			<groupId>commons-codec</groupId>
			<artifactId>commons-codec</artifactId>
			<version>1.18.0</version><!--$NO-MVN-MAN-VER$-->
		</dependency>
		<dependency>
			<groupId>com.google.zxing</groupId>
			<artifactId>javase</artifactId>
			<version>${zxing.version}</version>
		</dependency>
		<dependency>
			<groupId>org.apache.tika</groupId>
			<artifactId>tika-core</artifactId>
			<version>3.2.2</version>
		</dependency>
		<dependency>
			<groupId>org.locationtech.jts</groupId>
			<artifactId>jts-core</artifactId>
			<version>${jts.version}</version>
		</dependency>
		<!-- Disabled because automatic restarts can interfere with concurrent IDE edits.
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-devtools</artifactId>
			<scope>runtime</scope>
			<optional>true</optional>
		</dependency>
		-->
	</dependencies>
	<build>
		<!--
			No <resources> override on purpose: spring-boot-starter-parent already filters ONLY
			application*.properties/yml/yaml (with the @...@ delimiter) and copies every other
			resource byte-for-byte. A blanket <filtering>true</filtering> re-encodes the UTF-8
			templates and, on Windows/m2e, double-encodes accents (ç -> Ã§). Inheriting the
			parent avoids that and also covers profile files (application-dev.properties, .yml).
		-->
		<pluginManagement>
			<plugins>
				<!-- Pin the SonarScanner version so `sonar:sonar` is reproducible instead
				     of resolving the latest release at run time. -->
				<plugin>
					<groupId>org.sonarsource.scanner.maven</groupId>
					<artifactId>sonar-maven-plugin</artifactId>
					<version>${sonar-maven-plugin.version}</version>
				</plugin>
			</plugins>
		</pluginManagement>
		<plugins>
			<plugin>
				<groupId>org.springframework.boot</groupId>
				<artifactId>spring-boot-maven-plugin</artifactId>
				<executions>
					<execution>
						<goals>
							<goal>repackage</goal>
						</goals>
					</execution>
					<!-- Writes META-INF/build-info.properties so the running application can state
					     its own version. Question one of any support request is "which version are
					     you on", and without this the answer exists only in the pom. -->
					<execution>
						<id>build-info</id>
						<goals>
							<goal>build-info</goal>
						</goals>
					</execution>
				</executions>
				<!-- spring-boot:run executes from the exploded classpath, so the packaged jar's
				     Enable-Native-Access manifest entry does not apply; pass the flag here so the
				     Windows FFM change source (WindowsKernel32) runs without the restricted-method
				     warning. -->
				<configuration>
					<jvmArguments>--enable-native-access=ALL-UNNAMED</jvmArguments>
				</configuration>
			</plugin>
			<!-- Declares that the app uses the Foreign Function & Memory API to reach kernel32
			     (the Windows change source), so `java -jar` runs without the Java 25 restricted
			     native-access warning and stays ready for future JDKs that deny it by default.
			     Set on the intermediate jar; spring-boot:repackage preserves existing manifest
			     entries, so it carries over to the final executable jar. Version comes from the
			     spring-boot-starter-parent. -->
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-jar-plugin</artifactId>
				<configuration>
					<archive>
						<manifestEntries>
							<Enable-Native-Access>ALL-UNNAMED</Enable-Native-Access>
						</manifestEntries>
					</archive>
				</configuration>
			</plugin>
			<!-- Build-time guard: after repackage, read the final executable jar's manifest and
			     fail the build if the native-access declaration or the Spring Boot launcher entries
			     drifted. Bound to package and declared after spring-boot-maven-plugin, so it runs on
			     the repackaged jar (not the intermediate one). Version comes from the parent. -->
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-antrun-plugin</artifactId>
				<executions>
					<!--
					     jpackage marks the launcher it produces read-only, and neither Ant nor the clean
					     plugin can delete a read-only file on Windows: after one installer build, every
					     later "mvn clean" failed on target/installer. Clearing the attribute before clean
					     runs keeps that out of the way for good, whichever profile produced the image.
					-->
					<execution>
						<id>release-installer-image</id>
						<phase>pre-clean</phase>
						<goals>
							<goal>run</goal>
						</goals>
						<configuration>
							<target>
								<exec executable="attrib" osfamily="windows" failifexecutionfails="false"
										dir="${project.build.directory}" failonerror="false">
									<arg value="-R"/>
									<arg value="installer\*"/>
									<arg value="/S"/>
									<arg value="/D"/>
								</exec>
							</target>
						</configuration>
					</execution>
					<execution>
						<id>verify-executable-jar-manifest</id>
						<phase>package</phase>
						<goals>
							<goal>run</goal>
						</goals>
						<configuration>
							<target>
								<loadresource property="executable.jar.manifest">
									<zipentry zipfile="${project.build.directory}/${project.build.finalName}.jar"
										name="META-INF/MANIFEST.MF" />
								<!-- Un-wrap MANIFEST.MF 72-byte line continuations (CRLF + leading space) so the
								     Start-Class check below still matches when a long fully-qualified class name is
								     split across a continuation line. -->
								<filterchain>
									<tokenfilter>
										<filetokenizer />
										<replaceregex pattern="\r?\n " replace="" flags="gs" />
									</tokenfilter>
								</filterchain>
								</loadresource>
								<fail
									message="Executable jar manifest is missing 'Enable-Native-Access: ALL-UNNAMED'.">
									<condition>
										<not>
											<contains string="${executable.jar.manifest}"
												substring="Enable-Native-Access: ALL-UNNAMED" />
										</not>
									</condition>
								</fail>
								<fail
									message="Executable jar manifest lost the Spring Boot 'Main-Class' launcher entry.">
									<condition>
										<not>
											<contains string="${executable.jar.manifest}"
												substring="Main-Class: org.springframework.boot.loader" />
										</not>
									</condition>
								</fail>
								<fail
									message="Executable jar manifest lost the Spring Boot 'Start-Class' entry.">
									<condition>
										<not>
											<contains string="${executable.jar.manifest}"
												substring="Start-Class: br.com.jorgemelo.nimbusfilemanager.NimbusFileManagerApplication" />
										</not>
									</condition>
								</fail>
								<echo
									message="Verified executable jar manifest: Enable-Native-Access + Spring Boot launcher entries present." />
							</target>
						</configuration>
					</execution>
				</executions>
			</plugin>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-compiler-plugin</artifactId>
				<version>3.14.0</version><!--$NO-MVN-MAN-VER$-->
				<configuration>
					<release>${java.version}</release>
					<encoding>${project.build.sourceEncoding}</encoding>
					<annotationProcessorPaths>
						<path>
							<groupId>org.projectlombok</groupId>
							<artifactId>lombok</artifactId>
							<version>${lombok.version}</version>
						</path>
					</annotationProcessorPaths>
				</configuration>
			</plugin>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-resources-plugin</artifactId>
				<version>3.3.1</version><!--$NO-MVN-MAN-VER$-->
				<configuration>
					<encoding>${project.build.sourceEncoding}</encoding>
					<propertiesEncoding>${project.build.sourceEncoding}</propertiesEncoding>
				</configuration>
			</plugin>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-surefire-plugin</artifactId>
				<version>3.5.3</version><!--$NO-MVN-MAN-VER$-->
				<configuration>
					<argLine>@{argLine} -Dfile.encoding=${project.build.sourceEncoding}</argLine>
					<!-- Disable the folder-watch poll loop in the test JVM. No @SpringBootTest
					     exercises it, so its 500ms DB poll only wastes cycles and races the
					     Testcontainers/Hikari teardown at JVM exit (EOFException, "connection is
					     closed", ~30s hang, Surefire fork kill). Production keeps the default. -->
					<systemPropertyVariables>
						<nimbus-file-manager.inventory.watch.enabled>false</nimbus-file-manager.inventory.watch.enabled>
					<!-- No @SpringBootTest may reach for the network: the tool auto-install would
					     otherwise fetch a ~70 MB archive once per context on a Windows developer
					     machine. Its own test drives the component directly. -->
					<nimbus-file-manager.tools.auto-install>false</nimbus-file-manager.tools.auto-install>
					<!-- Same reason, and a stronger one: the PostgreSQL archive is several hundred MB,
					     and a test context that fetched it would do so before it could report why. -->
					<nimbus-file-manager.database.auto-install>false</nimbus-file-manager.database.auto-install>
					<!-- Third of the same family, and the one that was actually happening: every
					     @SpringBootTest found the boundary dataset missing, took the "acquire it
					     now, whatever the hour" branch, and pulled ~382 MB into target/, which the
					     next `mvn clean` deleted so the following build could fetch it again. -->
					<nimbus-file-manager.location.boundary.auto-update>false</nimbus-file-manager.location.boundary.auto-update>
					<!-- The suite brings its own database: every @SpringBootTest starts a throwaway
					     container. Running a cluster is the default everywhere else, so the one
					     place that already has a server has to say so - otherwise each context
					     would boot a second PostgreSQL beside the container it is already using. -->
					<nimbus-file-manager.database.embedded>false</nimbus-file-manager.database.embedded>
					<!-- The real workspace lives under the user's home, and the suite must never
					     write into it: a test that creates folders, logs or a cluster would be
					     doing it inside the installation people actually use. This keeps the run
					     inside target/, which `mvn clean` owns. -->
					<nimbus-file-manager.workspace>${project.build.directory}/test-workspace</nimbus-file-manager.workspace>
					<!-- Read from the real workspace, written to never: the backup tests need an
					     actual pg_dump and the media tests an actual ffmpeg. A machine without
					     them - the CI runner - simply finds nothing here and falls back to PATH,
					     which is where the workflow installs the PostgreSQL client. -->
					<nimbus-file-manager.tools>${user.home}/Nimbus File Manager/workspace/tools</nimbus-file-manager.tools>
					</systemPropertyVariables>
				</configuration>
			</plugin>
			<plugin>
				<groupId>org.jacoco</groupId>
				<artifactId>jacoco-maven-plugin</artifactId>
				<version>0.8.13</version>
				<configuration>
					<excludes>
						<exclude>br/com/jorgemelo/nimbusfilemanager/NimbusFileManagerApplication.class</exclude>
						<exclude>**/infrastructure/config/**</exclude>
						<exclude>**/domain/model/**</exclude>
						<exclude>br/com/jorgemelo/nimbusfilemanager/**/dto/**</exclude>
						<!-- Data-only constant holders (public static final fields + private ctor,
						     no logic) live in each domain's application/constants package (a general
						     <Domain>Constants plus dedicated cohesive holders like ExecutionMessages,
						     WorkspaceFolders); like DTOs there is nothing meaningful to cover. -->
						<exclude>**/application/constants/**</exclude>
						<exclude>**/*Constants.class</exclude>
						<exclude>**/repository/**</exclude>
						<exclude>**/*Repository.class</exclude>
						<!-- External-process glue (ffmpeg/exiftool/mediainfo spawn + stream draining):
						     cannot be meaningfully unit-tested, so it lives in dedicated *ProcessRunner
						     classes that are excluded here. Pure logic stays in the owning service. -->
						<exclude>**/*ProcessRunner.class</exclude>
						<!-- HTTP download adapter for the geoBoundaries dataset (client + ETag + network
						     IO). Like the process glue it is external-integration only (needs the real
						     API / a mock HTTP server), so it is covered by integration tests, not units. -->
						<exclude>**/GeoBoundariesSource.class</exclude>
						<!-- Windows-only FFM glue (kernel32 DeviceIoControl / OpenFileById /
						     ReadDirectoryChangesW via java.lang.foreign) in the ".../source/**/windows"
						     subpackages. Cannot run on the Linux CI, so it is covered by conditional
						     integration tests and manual runs; all the logic above it
						     (parsers/interpreters/sources/cursor/selection) is unit-tested. -->
						<exclude>**/windows/**</exclude>
						<!-- AWT tray glue (SystemTray\TrayIcon\PopupMenu + explorer.exe hand-off).
						     There is no tray on the headless CI, so every call is a no-op there and
						     what it does on a desktop is only visible on one. The words and the
						     address it opens live in TrayText, which is unit-tested. -->
						<exclude>**/infrastructure/desktop/**</exclude>
					</excludes>
				</configuration>
				<executions>
					<execution>
						<id>prepare-agent</id>
						<goals>
							<goal>prepare-agent</goal>
						</goals>
					</execution>
					<execution>
						<id>report</id>
						<phase>test</phase>
						<goals>
							<goal>report</goal>
						</goals>
						<configuration>
							<formats>
								<format>HTML</format>
								<format>XML</format>
							</formats>
						</configuration>
					</execution>
				</executions>
			</plugin>
			<plugin>
				<groupId>org.codehaus.mojo</groupId>
				<artifactId>exec-maven-plugin</artifactId>
				<version>3.5.0</version>
				<executions>
					<execution>
						<id>quality-summary</id>
						<phase>test</phase>
						<goals>
							<goal>java</goal>
						</goals>
						<configuration>
							<mainClass>br.com.jorgemelo.nimbusfilemanager.quality.QualitySummary</mainClass>
							<classpathScope>test</classpathScope>
							<cleanupDaemonThreads>false</cleanupDaemonThreads>
						</configuration>
					</execution>
				</executions>
			</plugin>
		</plugins>
	</build>
	<profiles>
		<profile>
			<id>pitest</id>
			<build>
				<plugins>
					<plugin>
						<groupId>org.pitest</groupId>
						<artifactId>pitest-maven</artifactId>
						<version>${pitest.version}</version>
						<dependencies>
							<dependency>
								<groupId>org.pitest</groupId>
								<artifactId>pitest-junit5-plugin</artifactId>
								<version>${pitest-junit5-plugin.version}</version>
							</dependency>
						</dependencies>
						<configuration>
							<targetClasses>
								<param>br.com.jorgemelo.nimbusfilemanager.*</param>
							</targetClasses>
							<targetTests>
								<param>br.com.jorgemelo.nimbusfilemanager.*</param>
							</targetTests>
							<!-- Mirror the JaCoCo <excludes> / sonar.coverage.exclusions so the mutation
							     universe matches what is meant to be unit-tested. These are PIT class-name
							     globs (not path globs): '*' spans package separators, so '*.domain.model.*'
							     means "any class in a domain.model package". -->
							<excludedClasses>
								<param>br.com.jorgemelo.nimbusfilemanager.NimbusFileManagerApplication</param>
								<param>*.infrastructure.config.*</param>
								<param>*.domain.model.*</param>
								<param>*.dto.*</param>
								<param>*.application.constants.*</param>
								<param>*Constants</param>
								<param>*.repository.*</param>
								<param>*Repository</param>
								<param>*ProcessRunner</param>
								<param>*GeoBoundariesSource</param>
								<param>*.windows.*</param>
								<param>*.infrastructure.desktop.*</param>
							</excludedClasses>
							<!-- Testcontainers / @SpringBootTest classes cannot drive mutation testing:
							     booting a Spring context (and a Postgres container) once per mutation is
							     intractable. Excluding them makes a whole-project run feasible; the trade-off
							     is that production code covered ONLY by these is under-reported. Most end in
							     IntegrationTest; the two that do not are listed explicitly. -->
							<excludedTestClasses>
								<param>*IntegrationTest</param>
								<param>*PhashBacklogAsyncRunnerTest</param>
								<param>*InventoryOrganizationReinventoryTest</param>
							</excludedTestClasses>
							<outputFormats>
								<param>HTML</param>
								<param>XML</param>
							</outputFormats>
							<timestampedReports>false</timestampedReports>
							<withHistory>false</withHistory>
						</configuration>
					</plugin>
				</plugins>
			</build>
		</profile>
		<!--
		     The application image, built by the JDK's own jpackage - no extra tooling to
		     install and nothing to keep in step with the Java version. Off by default
		     because it only runs on the platform it targets: mvn -Pinstaller package

		     What comes out is a self-contained folder that runs as it is. Turning it into
		     an installer is the installer-msi profile below, kept apart because that step
		     needs WiX and this one needs nothing.
		-->
		<profile>
			<id>installer</id>
			<build>
				<plugins>
					<plugin>
						<groupId>org.codehaus.mojo</groupId>
						<artifactId>build-helper-maven-plugin</artifactId>
						<version>3.6.0</version>
						<executions>
							<!-- jpackage only accepts major.minor.patch, and the project version carries a
							     fourth build number. Deriving it here keeps the version single-sourced in
							     <version> instead of repeated in a property nobody remembers to bump. -->
							<execution>
								<id>installer-version</id>
								<phase>prepare-package</phase>
								<goals>
									<goal>regex-property</goal>
								</goals>
								<configuration>
									<name>installer.app.version</name>
									<value>${project.version}</value>
									<regex>^(\d+)\.(\d+)\.(\d+).*$</regex>
									<replacement>$1.$2.$3</replacement>
									<failIfNoMatch>true</failIfNoMatch>
								</configuration>
							</execution>
						</executions>
					</plugin>
					<plugin>
						<groupId>org.apache.maven.plugins</groupId>
						<artifactId>maven-antrun-plugin</artifactId>
						<executions>
							<!-- jpackage copies every file of its input folder into the image, so the jar gets
							     a folder of its own instead of dragging the whole target directory along. -->
							<execution>
								<id>installer-input</id>
								<phase>package</phase>
								<goals>
									<goal>run</goal>
								</goals>
								<configuration>
									<target>
										<!-- jpackage refuses to write into a destination that already exists, so the
										     folder goes first - and it marks the launcher read-only, which neither Ant
										     nor mvn clean can delete on Windows. Clearing the attribute first is what
										     keeps a second build (and every later clean) from failing on the leftover
										     image. The delete is not quiet: failing here beats letting jpackage write a
										     half image that starts and cannot find its own cfg. -->
										<exec executable="attrib" osfamily="windows" failifexecutionfails="false"
												dir="${project.build.directory}">
											<arg value="-R"/>
											<arg value="installer\*"/>
											<arg value="/S"/>
											<arg value="/D"/>
										</exec>
										<delete dir="${project.build.directory}/installer" failonerror="true"/>
										<mkdir dir="${project.build.directory}/installer/input"/>
										<copy file="${project.build.directory}/${project.build.finalName}.jar"
												todir="${project.build.directory}/installer/input"/>
										<!-- Nothing else goes in. PostgreSQL and ffmpeg used to be staged into the image,
										     which meant the machine building the installer had to have downloaded them
										     first - a pipeline never has - and put hundreds of MB of third-party binaries
										     inside a folder an installation may not be able to write to. Every tool is
										     downloaded on first start into the workspace instead. -->
									</target>
								</configuration>
							</execution>
						</executions>
					</plugin>
					<plugin>
						<groupId>org.codehaus.mojo</groupId>
						<artifactId>exec-maven-plugin</artifactId>
						<executions>
							<execution>
								<id>jpackage</id>
								<phase>package</phase>
								<goals>
									<goal>exec</goal>
								</goals>
								<configuration>
									<executable>${java.home}/bin/jpackage</executable>
									<arguments>
										<argument>--type</argument>
										<argument>app-image</argument>
										<argument>--name</argument>
										<argument>Nimbus File Manager</argument>
										<argument>--app-version</argument>
										<argument>${installer.app.version}</argument>
										<argument>--vendor</argument>
										<argument>Jorge Melo</argument>
										<argument>--input</argument>
										<argument>${project.build.directory}/installer/input</argument>
										<argument>--main-jar</argument>
										<argument>${project.build.finalName}.jar</argument>
										<argument>--dest</argument>
										<argument>${project.build.directory}/installer</argument>
										<!-- The packaged jar declares this in its manifest, but jpackage launches the
										     jar through its own launcher, so the flag has to be passed again or the
										     Windows change source warns on every start. -->
										<argument>--java-options</argument>
										<argument>--enable-native-access=ALL-UNNAMED</argument>
										<!-- The launcher, the taskbar and the installer all show this. Without it they
										     show the generic Java cup, which reads as "some Java thing" rather than as a
										     product. The same file the browser tab already uses. -->
										<argument>--icon</argument>
										<argument>${project.basedir}/src/main/resources/static/favicon.ico</argument>
									</arguments>
								</configuration>
							</execution>
						</executions>
					</plugin>
				</plugins>
			</build>
		</profile>
		<!--
		     The MSI, from the image the profile above just produced: an entry in Programs
		     and Features, a Start menu shortcut and an uninstaller, instead of a folder the
		     user has to file away somewhere. Separate profile because it needs WiX on the
		     PATH - v3 as light.exe/candle.exe, or v4/v5 as wix.exe - which the image does
		     not: mvn -Pinstaller,installer-msi package
		-->
		<profile>
			<id>installer-msi</id>
			<build>
				<plugins>
					<plugin>
						<groupId>org.codehaus.mojo</groupId>
						<artifactId>exec-maven-plugin</artifactId>
						<executions>
							<execution>
								<id>jpackage-msi</id>
								<phase>package</phase>
								<goals>
									<goal>exec</goal>
								</goals>
								<configuration>
									<executable>${java.home}/bin/jpackage</executable>
									<arguments>
										<argument>--type</argument>
										<argument>msi</argument>
										<argument>--name</argument>
										<argument>Nimbus File Manager</argument>
										<argument>--app-version</argument>
										<argument>${installer.app.version}</argument>
										<argument>--vendor</argument>
										<argument>Jorge Melo</argument>
										<!-- Packaged from the image rather than from the jar again, so what ships is
										     exactly what was already produced, and the launcher's own arguments live in
										     one place instead of two that can drift apart. -->
										<argument>--app-image</argument>
										<argument>${project.build.directory}/installer/Nimbus File Manager</argument>
										<argument>--dest</argument>
										<argument>${project.build.directory}/installer</argument>
										<!-- Fixed forever, and the single most consequential line here. Windows decides
										     "upgrade this installation" against "install a second one" by this code
										     alone. jpackage invents a fresh one on every build when it is absent, so
										     each version would land beside the previous - two entries, two folders, two
										     launchers - and changing it later does the same thing once. -->
										<argument>--win-upgrade-uuid</argument>
										<argument>4AB605B6-D275-45FB-84FD-174F69293136</argument>
										<argument>--win-menu</argument>
										<argument>--win-menu-group</argument>
										<argument>Nimbus File Manager</argument>
										<argument>--win-shortcut</argument>
										<!-- Lets the person installing choose where it goes. Without it the folder is
										     fixed, and an installation cannot be put on the drive that has room. -->
										<argument>--win-dir-chooser</argument>
									</arguments>
								</configuration>
							</execution>
						</executions>
					</plugin>
				</plugins>
			</build>
		</profile>
	</profiles>
</project>